meta {
  name: sign-up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/{{path}}/sign-up
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

script:pre-request {
  const email = bru.interpolate("{{$randomEmail}}");
  bru.setVar("email", email);
  
  const firstName = bru.interpolate("{{$randomFirstName}}");
  bru.setVar("firstName", firstName);
  
  const lastName = bru.interpolate("{{$randomLastName}}");
  bru.setVar("lastName", lastName);
  
  const password = bru.interpolate("{{$randomPassword}}");
  
  const body = {
    email,
    'first-name': firstName,
    'last-name': lastName,
    password,
    'confirm-password': password
  };
  console.log(body)
  
  req.setBody(body);
}

tests {
  test("should create a new user and return 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("should send the 'set-cookie' header with the 'auth-token'", function () {
    expect(res.getHeader("set-cookie"))
      .to
      .satisfy(arr => 
        arr.some(str => str.includes("auth-token"))
      )
  });
  
  test("Should return correct body", function () {
    const email = bru.getVar("email");
    const firstName = bru.getVar("firstName");
    const lastName = bru.getVar("lastName");
  
    
    const body = res.getBody();
    
    expect(body).to.have.property("id");
    expect(body.email).to.eql(email);
    expect(body.firstName).to.eql(firstName);
    expect(body.lastName).to.eql(lastName);
  
  
  })
}

settings {
  encodeUrl: true
  timeout: 0
}
