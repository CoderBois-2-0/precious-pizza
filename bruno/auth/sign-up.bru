meta {
  name: sign-up
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/{{path}}/sign-up
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{$randomEmail}}",
    "first-name": "{{$randomFirstName}}",
    "last-name": "{{$randomLastName}}"
  }
}

script:pre-request {
  const password = bru.interpolate("{{$randomPassword}}");
  
  const body = req.getBody();
  req.setBody({ ...body, password, 'confirm-password': password });
}

tests {
  test("should create a new user", function () {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("should send the 'set-cookie' header with the 'auth-token'", function () {
    expect(res.getHeader("set-cookie"))
      .to
      .satisfy(arr => 
        arr.some(str => str.includes("auth-token"))
      )
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
