meta {
  name: sign-out
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/{{path}}/sign-out
  body: none
  auth: inherit
}

body:json {
  {
    "email": "example@example.com",
    "password": "adminAdmin"
  }
}

tests {
  test("should sign out user", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should set 'auth-token' to 'Max-Age' to 0", function () {
    expect(res.getHeader("set-cookie"))
      .to
      .satisfy(arr => 
        arr.some(str => str.includes("auth-token")) && 
        arr.some(str => str.includes("Max-Age=0"))
      )
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
