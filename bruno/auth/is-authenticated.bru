meta {
  name: is-authenticated
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/{{path}}/is-authenticated
  body: none
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "example@example.com",
    "password": "adminAdmin"
  }
}

tests {
  test("should return a status of 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Should have correct json body", function () {
    const body = res.getBody();
    
    expect(body).to.have.property("id");
    expect(body).to.have.property("email");
    expect(body).to.have.property("firstName");
    expect(body).to.have.property("lastName");
    expect(body).to.have.property("role");
  
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
