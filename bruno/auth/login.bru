meta {
  name: login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/{{path}}/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "example@example.com",
    "password": "adminAdmin"
  }
}

tests {
  test("should create a new user", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("should send the 'set-cookie' header with the 'auth-token'", function () {
    expect(res.getHeader("set-cookie"))
      .to
      .satisfy(arr => 
        arr.some(str => str.includes("auth-token"))
      )
  });
  
}

settings {
  encodeUrl: true
  timeout: 0
}
